# Cursor AI Ignore
# Impede indexação de arquivos pesados, binários, dependências e ruídos de contexto.

# Dependências e compilação
node_modules/
dist/
dist-ssr/
build/
.cache/

# Git e controle de versão
.git/

# Locks e metadados pesados (evita poluição no índice semântico)
package-lock.json
pnpm-lock.yaml
yarn.lock

# Logs e arquivos temporários
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
.DS_Store
Thumbs.db

# Configurações de ambiente e arquivos locais
*.local
.env*.local

# Bancos de dados locais / temporários / OPFS
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db3
.finback/

# Configurações de IDE irrelevantes para o agente
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
